# Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Channel ID for free alerts (delayed by config.json's freeAlertDelayMs) -
# right-click channel -> Copy Channel ID, requires Developer Mode enabled
# in Discord settings
ALERTS_CHANNEL_ID=

# Channel ID for paid subscribers - alerts post here instantly, with no delay
INSTANT_ALERTS_CHANNEL_ID=

# Your own Discord user ID - health-check failures get DMed here, not posted publicly
ADMIN_DISCORD_ID=

# The Discord server (guild) ID this bot operates in - right-click the
# server icon -> Copy Server ID
GUILD_ID=

# The role granted to paying subscribers - Server Settings -> Roles ->
# create a role (e.g. "Subscriber"), right-click it -> Copy Role ID.
# The bot's own role must be positioned ABOVE this role for it to be able
# to grant/revoke it.
SUBSCRIBER_ROLE_ID=

# From your Stripe dashboard (Developers -> API keys)
STRIPE_SECRET_KEY=

# The Price ID (starts with "price_") for the £10/month subscription
# product you create in Stripe
STRIPE_PRICE_ID=

# From the webhook endpoint you create in Stripe (Developers -> Webhooks),
# pointed at https://<your-render-url>/stripe/webhook, listening for
# checkout.session.completed and customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=

# Optional: where Stripe Checkout redirects after payment/cancellation.
# Defaults to discord.com if not set.
CHECKOUT_SUCCESS_URL=
CHECKOUT_CANCEL_URL=
